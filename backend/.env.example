PORT=4000
NODE_ENV=development

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://embu_admin:embu_password@localhost:5432/embu_coop_system?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# CORS
FRONTEND_ORIGIN="http://localhost:3000"

# TEST-RUN ONLY: set to "true" to enable open self-signup (any email domain
# accepted) for Field Officer / Cooperative Manager roles. Leave unset/"false"
# in any real deployment — see RENDER_DEPLOYMENT.md.
ALLOW_OPEN_SIGNUP="false"

# Object storage (S3-compatible) - used for pre-signed document URLs
S3_ENDPOINT=""
S3_BUCKET="embu-coop-documents"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="eu-west-1"
PRESIGNED_URL_TTL_SECONDS=900

# 1/3 gender rule. "false"/unset = suspended: committees that fail the rule are
# still saved and shown as NON_COMPLIANT, but not blocked. Set "true" to block
# non-compliant submissions again (Director override with justification).
ENFORCE_GENDER_RULE="false"

# Number of reverse proxies in front of the API (Render = 1). Needed so rate
# limits see each visitor's real address. Use 0 when running locally.
TRUST_PROXY_HOPS="1"

# A sign-in with the published test password forces a password change.
# Only set "false" for a throw-away demo.
FORCE_DEFAULT_PASSWORD_CHANGE="true"

# Two-step sign-in (authenticator app). Roles that MUST use it; they are made to
# set it up at their next sign-in. "false" switches the requirement off.
MFA_ENFORCEMENT="true"
MFA_REQUIRED_ROLES="NATIONAL_ADMIN,DIRECTOR"
# Optional separate key for encrypting the stored secrets. If unset, JWT_SECRET
# is used (then changing JWT_SECRET also invalidates everyone's two-step set-up).
MFA_ENCRYPTION_KEY=""
